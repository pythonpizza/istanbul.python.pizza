---
import Base from "@layouts/Base.astro";
import Header from "@components/Header.astro";
import CtaButton from "@components/CtaButton.astro";
import Section from "@components/Section.astro";
import Prose from "@components/Prose.astro";
import Footer from "@components/Footer.astro";
import EventJsonLd from "@components/EventJsonLd.astro";
import Hero from "@sections/Hero.astro";
import Sponsors from "@sections/Sponsors.astro";
// import Schedule from "@sections/Schedule.astro";
import Organizers from "@sections/Organizers.astro";
import Venue from "@sections/Venue.astro";
import AboutContent from "@prose/about.mdx";
import CfpContent from "@prose/cfp.mdx";
import CocContent from "@prose/coc.mdx";
import { event } from "@data/event";
import { socials } from "@data/socials";

const twitter = socials.find((s) => s.handle);
---

<Base
  title={event.name}
  description={event.description}
  ogImage={new URL("/social-image.jpg", Astro.site).href}
>
  <Fragment slot="head">
    <meta property="og:title" content={event.name} />
    <meta property="og:description" content={event.description} />
    {twitter && <meta name="twitter:site" content={twitter.handle} />}
    <meta name="twitter:image:alt" content="Conference logo" />
    <EventJsonLd />
  </Fragment>

  <Header />
  <div class="fixed right-4 bottom-4 md:right-8 md:bottom-8 z-20 flex flex-col items-end gap-3">
    {event.ctas.filter((cta) => cta.floating).map((cta) => (
      <CtaButton
        id={`floating-${cta.id}`}
        href={cta.href}
        class="cta-hidden min-w-40 md:min-w-44 shadow-lg"
      >
        {cta.label}
      </CtaButton>
    ))}
  </div>
  <main>
    <Hero />
    <Section id="about" title={`Python Pizza is Coming to ${event.city}!`}>
      <Prose><AboutContent /></Prose>
    </Section>
    <Section id="cfp" title="Call for Proposals: Deadline Extended! 🎤">
      <Prose><CfpContent /></Prose>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <CtaButton href={event.cfp.url}>Submit a talk! 🎤</CtaButton>
        <CtaButton href="/cfp/">Read the full CFP →</CtaButton>
      </div>
    </Section>
    <Venue />
    <Sponsors />
    {/* <Schedule /> */}
    <Organizers />
    <Section id="coc" title="Code of Conduct">
      <Prose class="text-left [&_ul]:list-none [&_ul]:pl-0"><CocContent /></Prose>
    </Section>
  </main>
  <Footer />

  <script define:vars={{ ctaIds: event.ctas.filter((cta) => cta.floating).map((cta) => cta.id) }}>
    // each floating cta appears once its hero counterpart scrolls out of view
    function bindFloatingCta(heroId, floatingId) {
      const hero = document.getElementById(heroId);
      const floating = document.getElementById(floatingId);
      if (!hero || !floating) return;
      const observer = new IntersectionObserver(
        ([entry]) => floating.classList.toggle("cta-hidden", entry.isIntersecting),
        { threshold: 0.4 },
      );
      observer.observe(hero);
    }

    for (const id of ctaIds) {
      bindFloatingCta(`hero-${id}`, `floating-${id}`);
    }
  </script>
</Base>
