---
import { Image } from "astro:assets";
import SocialLink from "@components/SocialLink.astro";
import { formatSessionTime } from "@data/schedule";
import type { ImageMetadata } from "astro";

interface Link {
  url: string;
  icon: string;
  label: string;
}

interface Speaker {
  id: string;
  name: string;
  image?: ImageMetadata;
  links?: Link[];
}

interface Session {
  label?: string;
  title?: string;
  speakerIds?: string[];
  when?: string;
  until?: string;
  isKeynote?: boolean;
  isHighlight?: boolean;
  description?: string;
  language?: "EN" | "TR";
}

interface Props {
  session: Session;
  speakers: Speaker[];
  invert?: boolean;
}

const { session, speakers, invert = false } = Astro.props;

const timeRange = session.when
  ? session.until
    ? `${formatSessionTime(session.when)}-${formatSessionTime(session.until)}`
    : formatSessionTime(session.when)
  : null;

const isInfo = Boolean(session.label);
const languageNames = { EN: "English", TR: "Turkish" };
const photos = speakers.flatMap((s) =>
  s.image ? [{ src: s.image, name: s.name }] : [],
);
const multiPhoto = photos.length > 1;
const photoCol = multiPhoto ? "7.5rem" : "11.5rem";
const gridCols = invert ? `1fr ${photoCol}` : `${photoCol} 1fr`;
---

<div class="relative mt-8">
  {isInfo ? (
    <div
      class:list={[
        "stripe-badge flex items-center justify-center px-8 py-4 md:px-24 rounded-[2.4rem] md:rounded-full bg-primary text-white text-center",
        session.isHighlight
          ? "min-h-28 md:min-h-30 text-xl md:text-3xl font-semibold shadow-[0_8px_32px_-12px_#ed4337]"
          : "text-base md:text-xl",
      ]}
    >
      {session.label}
    </div>
  ) : (
    <div
      class:list={[
        "rounded-[2rem] md:rounded-[2.5rem] shadow-[0_4px_28px_-8px_#cac9c9] p-5 md:px-8 md:py-5 flex flex-col items-center md:gap-x-6 md:gap-y-2",
        session.isKeynote ? "border-[3px] border-primary shadow-[0_8px_32px_-12px_#ed4337]" : "border border-gray-100",
        photos.length > 0 ? "md:grid md:items-center md:justify-items-center" : "",
      ]}
      style={photos.length > 0 ? `grid-template-columns: ${gridCols}` : ""}
    >
      {photos.length > 0 && (
        <div
          class:list={[
            "relative flex items-center justify-center mb-4 md:mb-0 row-[1/span_2]",
            multiPhoto ? "w-18 h-18 md:w-30 md:h-30" : "w-20 h-20 md:w-42 md:h-42",
            invert ? "md:order-2 md:col-start-2" : "md:col-start-1",
          ]}
        >
          {photos.map((photo, i) => (
            <Image
              src={photo.src}
              alt={photo.name}
              width={480}
              format="avif"
              class:list={[
                "rounded-full object-cover",
                multiPhoto
                  ? "w-12 h-12 md:w-20 md:h-20 absolute border-[3px] border-white avatar-shadow"
                  : "w-full h-full avatar-shadow",
              ]}
              style={multiPhoto ? `top: ${i === 0 ? "0" : "1.5rem"}; left: ${i === 0 ? "0" : "1.5rem"}; z-index: ${photos.length - i}` : ""}
            />
          ))}
        </div>
      )}

      <h2
        class:list={[
          "w-full text-text font-mono font-normal text-lg md:text-xl leading-snug m-0 mb-3 md:mb-2 wrap-break-word",
          photos.length > 0 && (invert ? "md:col-start-1" : "md:col-start-2"),
        ]}
      >
        {session.title}
      </h2>

      <div
        class:list={[
          "w-full flex flex-wrap items-center justify-center gap-3 text-sm md:text-xl",
          photos.length > 0 && (invert ? "md:col-start-1" : "md:col-start-2"),
        ]}
      >
        {session.isKeynote && (
          <span class="text-primary font-mono text-base font-medium">Keynote speaker</span>
        )}
        {session.description && <span>{session.description}</span>}
        {speakers.map((speaker) => (
          <span class="inline-flex items-center gap-2 flex-wrap justify-center">
            <span>{speaker.name}</span>
            {speaker.links?.map((link) => (
              <SocialLink
                url={link.url}
                icon={link.icon}
                label={link.label}
                ariaLabel={`${speaker.name} ${link.label}`}
                size={22}
              />
            ))}
          </span>
        ))}
      </div>
    </div>
  )}

  {timeRange && (
    <span
      class:list={[
        "absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 px-2.5 py-1 leading-none rounded-full font-mono text-sm md:text-base whitespace-nowrap shadow-[0_4px_16px_-8px_#464444] z-10",
        isInfo ? "bg-white text-primary" : "bg-primary text-white",
      ]}
      title={session.language && languageNames[session.language]}
    >
      {timeRange}
      {session.language && ` · ${session.language}`}
    </span>
  )}
</div>
